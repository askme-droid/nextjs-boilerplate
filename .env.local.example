# Copy this file to .env.local and fill in the values.

# --- Railway Postgres + Drizzle ---
# Railway dashboard -> your Postgres service -> Connect -> Postgres Connection URL.
DATABASE_URL=postgresql://user:password@host:port/railway

# --- Better-Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Resend (Better-Auth's verification/reset emails) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@your-verified-domain

# SERVER-ONLY. Used by /admin/listings/new's "Generate from a description or
# flyer" feature (lib/ai/generate-listing.ts). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key
