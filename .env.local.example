# Copy this file to .env.local and fill in the values. On Cloudflare, set the
# same names under Worker -> Settings -> Variables and Secrets.

# --- Railway Postgres + Drizzle ---
# Railway dashboard -> your Postgres service -> Connect -> Postgres Connection URL.
DATABASE_URL=postgresql://user:password@host:port/railway

# --- Better-Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Resend (Better-Auth's verification/reset emails) ---
RESEND_API_KEY=your-resend-api-key
# Quoted because a display name + address contains a space and angle
# brackets, which several shells (bash `source`, etc.) would otherwise
# misparse as redirection syntax.
EMAIL_FROM="Your App Name <noreply@your-verified-domain>"

# SERVER-ONLY. Used by /admin/listings/new's "Generate from a description or
# flyer" feature (lib/ai/generate-listing.ts). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Cloudflare R2 (listing photos + homepage slider videos, lib/storage/r2.ts) ---
# Cloudflare dashboard -> R2 -> your bucket. Endpoint and keys come from
# R2 -> Manage API tokens (Object Read & Write, scoped to the bucket).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=fdsg-media
# Bucket -> Settings -> Public Development URL (r2.dev), or a custom domain.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Flyer print tool: WebGPU "Enhance with AI" (optional, build-time) ---
# The WebGPU runtime file (~26.8 MB) is over Cloudflare's 25 MiB static-file
# limit, so it's served from R2. Upload
# node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.wasm to the
# bucket and put its public URL here. Unset = the slower CPU path is used.
NEXT_PUBLIC_ORT_ASYNCIFY_WASM_URL=
