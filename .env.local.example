# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import it from a Client Component, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER-ONLY. Used by /admin/listings/new's "Generate from a description or
# flyer" feature (lib/ai/generate-listing.ts). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key
