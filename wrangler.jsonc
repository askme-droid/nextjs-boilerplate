{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The FD.SG directory (directories.fd.sg), built with OpenNext.
  // Deploy: `npm run deploy`, or Cloudflare Workers Builds on push to main.
  "name": "fdsg-directory",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Env vars and secrets (DATABASE_URL, BETTER_AUTH_SECRET, R2_*, ...) are set
  // in the Cloudflare dashboard (Worker -> Settings -> Variables and Secrets);
  // keep them there instead of letting a deploy wipe dashboard-only vars.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    // Per-request traces (each D1 query / fetch with its timing), in the
    // dashboard under Observability -> Traces.
    "traces": { "enabled": true }
  },
  // Keep the *.workers.dev test addresses on (wrangler turns them off by
  // default once "routes" is set).
  "workers_dev": true,
  // The live address. Cloudflare creates its DNS record on deploy.
  "routes": [{ "pattern": "directories.fd.sg", "custom_domain": true }],
  // The database: Cloudflare D1 (SQLite). Code: lib/db/client.ts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fdsg-directory",
      // Workers & Pages -> D1 -> fdsg-directory -> Database ID
      "database_id": "b505f1e0-f978-48ec-b0c3-ad53fe2fc71c",
      "migrations_dir": "migrations"
    }
  ],
  // Staging copy for testing before live: `npm run deploy:staging`, or
  // Cloudflare Workers Builds on push to the `staging` branch with the deploy
  // command `npx opennextjs-cloudflare deploy --env staging`. Deploys as the
  // Worker "fdsg-directory-staging", with its own settings in the dashboard.
  "env": {
    // Settings not repeated here (keep_vars, assets, observability) are
    // inherited from the top level; bindings such as d1_databases are not.
    "staging": {
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fdsg-directory-staging",
          // Workers & Pages -> D1 -> fdsg-directory-staging -> Database ID
          "database_id": "cbad6373-a3a0-4706-8449-c280d9a48d37",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
